# Copy to .env for local development. Every variable is read by `forma serve` (server/internal/platform/config).

# Admin origin. In development the Vite dev server (http://localhost:5173) proxies API calls to the Go server.
WEBAPP_URL=http://localhost:5173
# Optional separate origin for public surveys and the client API.
# PUBLIC_URL=

HTTP_ADDR=:3000
SHUTDOWN_TIMEOUT=20s

DATABASE_URL=postgres://forma:forma@localhost:5432/forma?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20

# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_FORMAT=text
