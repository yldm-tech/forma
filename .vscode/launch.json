{
  "configurations": [
    {
      "name": "Go: forma serve",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/apps/server/cmd/forma",
      "args": ["serve"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Web: Vite dev server (start `make dev-web` first)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173/",
      "webRoot": "${workspaceFolder}/apps/web"
    }
  ],
  "version": "0.2.0"
}
