# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
.pnp
.pnp.js
.pnpm-store/

# testing
**/coverage

# node
**/dist/

# misc
**/.DS_Store
*.pem
Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# cloud credentials belong outside the repo; these keep the obvious in-repo spots from being committable
**/gcp*.json
**/service-account*.json
**/*-credentials.json
secrets/

# build tools
**/*vite.config.*.timestamp-*

# environment specific
.direnv

# project specific
.local/

# IntelliJ IDEA
/.idea/
/*.iml
# Lingo.dev translation cache, and the bundle report `build:analyze` writes in packages/surveys
i18n.cache
stats.html

# machine-local agent settings
.claude/
.agents/

# v3 API contract tests: generated fixture id map, Schemathesis' local replay cache, and the
# bytecode cache Python leaves next to hooks.py
docs/api-v3-reference/contract-tests/fixtures.json
.schemathesis/
__pycache__/

# Go server: the SPA build is copied in at build time; only the placeholder is tracked
# `**/dist/` above ignores the directory itself, and git never re-includes a file inside an ignored directory, so the directory is re-included first.
!server/internal/webui/dist/
server/internal/webui/dist/*
!server/internal/webui/dist/.gitkeep
/bin/

# SDK bundles copied in by packages/vite-plugins at build time
web/public/js

# Vitest attachments and cache
**/.vitest/

# Playwright (e2e/)
**/test-results/
/playwright-report/
/blob-report/
