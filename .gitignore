# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
.pnp
.pnp.js
.pnpm-store/

# testing
**/coverage

# node
**/dist/

# misc
**/.DS_Store
*.pem
Zone.Identifier

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local

# cloud credentials belong outside the repo; these keep the obvious in-repo spots from being committable
**/gcp*.json
**/service-account*.json
**/*-credentials.json
secrets/

# build tools
**/*vite.config.*.timestamp-*

# environment specific
.direnv

# project specific
.local/

# IntelliJ IDEA
/.idea/
/*.iml
# Lingo.dev translation cache, and the bundle report `build:analyze` writes in packages/surveys
i18n.cache
stats.html

# machine-local agent settings
.claude/
.agents/

# Go server: the SPA build is copied in at build time; only the placeholder is tracked
# `**/dist/` above ignores the directory itself, and git never re-includes a file inside an ignored directory, so the directory is re-included first.
!apps/server/internal/webui/dist/
apps/server/internal/webui/dist/*
!apps/server/internal/webui/dist/.gitkeep
/bin/

# SDK bundles copied in by tooling/vite-plugins at build time
apps/web/public/js

# Vitest attachments and cache
**/.vitest/

# Playwright (apps/e2e/)
**/test-results/
/apps/e2e/playwright-report/
/apps/e2e/blob-report/
