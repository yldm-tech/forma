{
  "name": "@forma/jobs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules coverage dist",
    "build": "tsc && vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@forma/database": "workspace:*",
    "@forma/logger": "workspace:*",
    "@forma/types": "workspace:*",
    "bullmq": "5.61.0",
    "ioredis": "5.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@forma/config-eslint": "workspace:*",
    "@forma/config-typescript": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitest": "catalog:"
  }
}
