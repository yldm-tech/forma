{
  "name": "@forma/survey-ui",
  "license": "MIT",
  "version": "1.0.4",
  "description": "React UI components for building surveys and forms - includes NPS, rating scales, multi-select, file upload, and more. Built with Radix UI and Tailwind CSS.",
  "homepage": "https://forma.yldm.ai",
  "type": "module",
  "keywords": [
    "react",
    "survey",
    "form",
    "ui",
    "components",
    "nps",
    "rating",
    "questionnaire",
    "feedback",
    "forma",
    "tailwindcss",
    "typescript",
    "accessible"
  ],
  "author": {
    "name": "Forma",
    "url": "https://forma.yldm.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/forma",
    "directory": "packages/survey-ui"
  },
  "bugs": {
    "url": "https://github.com/yldm-tech/forma/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "source": "./src/index.ts",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": "./dist/survey-ui.css",
    "./youtube-id": {
      "types": "./dist/lib/youtube-id.d.ts",
      "import": "./dist/lib/youtube-id.js"
    },
    "./smileys": {
      "types": "./dist/components/general/smileys.d.ts",
      "import": "./dist/components/general/smileys.js"
    },
    "./storage": {
      "types": "./dist/lib/storage.d.ts",
      "import": "./dist/lib/storage.js"
    }
  },
  "scripts": {
    "dev": "vp build --watch --mode dev",
    "build": "vp build && node scripts/assert-scoped-css.mjs",
    "build:dev": "vp build --mode dev && node scripts/assert-scoped-css.mjs",
    "go": "vp build --watch --mode dev",
    "preview": "vp preview",
    "prepack": "node scripts/assert-pnpm-publish.mjs",
    "prepublishOnly": "node scripts/assert-pnpm-publish.mjs",
    "clean": "rimraf node_modules dist coverage",
    "ui:add": "npx shadcn@latest add",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@formkit/auto-animate": "catalog:",
    "@radix-ui/react-checkbox": "catalog:",
    "@radix-ui/react-dropdown-menu": "catalog:",
    "@radix-ui/react-popover": "catalog:",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "catalog:",
    "@radix-ui/react-slot": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "date-fns": "catalog:",
    "isomorphic-dompurify": "catalog:",
    "lucide-react": "catalog:",
    "react-day-picker": "catalog:",
    "tailwind-merge": "catalog:"
  },
  "devDependencies": {
    "@forma/config-typescript": "workspace:*",
    "@storybook/react": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "preact": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
