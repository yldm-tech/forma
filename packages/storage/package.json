{
  "name": "@forma/storage",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "homepage": "https://forma.ylam.ai",
  "description": "Storage Controller for Forma",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/forma"
  },
  "keywords": [
    "Forma",
    "storage",
    "storage controller"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "clean": "rimraf .turbo node_modules coverage dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:report": "eslint . --format json --output-file ../../lint-results/storage.json",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc --project tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "go": "vite build --watch --mode dev"
  },
  "author": "Forma <hola@forma.ylam.ai>",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-presigned-post": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@forma/logger": "workspace:*"
  },
  "devDependencies": {
    "@forma/config-eslint": "workspace:*",
    "@forma/config-typescript": "workspace:*",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
