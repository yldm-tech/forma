{
  "name": "@forma/i18n-utils",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://forma.yldm.ai",
  "license": "MIT",
  "description": "Utility functions for multilingual support in Forma projects",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js",
      "require": "./dist/canonical.cjs"
    },
    "./survey-runtime-languages": {
      "types": "./dist/survey-runtime-languages.d.ts",
      "import": "./dist/survey-runtime-languages.js",
      "require": "./dist/survey-runtime-languages.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yldm-tech/forma"
  },
  "keywords": [
    "Forma",
    "i18n",
    "internationalization",
    "localization"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "go": "vp build --watch --mode dev",
    "clean": "rimraf node_modules coverage dist",
    "build": "rimraf dist && tsc --project tsconfig.build.json && vp build",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:watch": "vp test",
    "scan-translations": "tsx src/scan-translations.ts"
  },
  "dependencies": {
    "glob": "catalog:",
    "object-hash": "3.0.0"
  },
  "devDependencies": {
    "@forma/config-typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/object-hash": "3.0.6",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
