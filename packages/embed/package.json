    "test:coverage": "vp test run --coverage"
  },
  "devDependencies": {
    "@forma/config-typescript": "workspace:*",
    "@forma/vite-plugins": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
