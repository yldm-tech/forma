{
  "name": "forma",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run --filter @forma/web dev",
    "clean": "vp run -r clean && rimraf node_modules coverage",
    "check": "pnpm catalog:check && pnpm api:v3:lint && vp check",
    "check:fix": "vp check --fix",
    "test": "vp run -r build && vp run -r test",
    "test:coverage": "vp run -r build && vp run -r test:coverage",
    "prepare": "vp config",
    "storybook": "vp run --filter storybook storybook",
    "catalog:check": "node scripts/check-catalog.mjs",
    "authzed:validate": "bash authzed/validate.sh",
    "api:v3:bundle": "node docs/api-v3-reference/scripts/bundle.mjs",
    "api:v3:lint": "node docs/api-v3-reference/scripts/bundle.mjs --lint",
    "api:v3:check": "node docs/api-v3-reference/scripts/bundle.mjs --check",
    "i18n:surveys:generate": "pnpm --filter @forma/surveys i18n:generate",
    "scan-translations": "pnpm --filter @forma/i18n-utils scan-translations",
    "i18n": "pnpm i18n:surveys:generate && pnpm scan-translations"
  },
  "devDependencies": {
    "@redocly/cli": "1.34.17",
    "js-yaml": "catalog:",
    "rimraf": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.7.0"
}
