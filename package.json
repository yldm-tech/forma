{
  "name": "forma",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run --filter @forma/web dev",
    "dev:website": "vp run --filter @forma/website dev",
    "clean": "vp run -r clean && rimraf node_modules coverage",
    "check": "pnpm catalog:check && pnpm tests:run-check && vp run -r build && vp check",
    "check:fix": "vp check --fix",
    "test": "vp run -r build && vp run -r test",
    "test:coverage": "vp run -r build && vp run -r test:coverage",
    "test:e2e": "vp run --filter @forma/e2e e2e",
    "prepare": "vp config",
    "storybook": "vp run --filter @forma/storybook storybook",
    "catalog:check": "node tooling/scripts/check-catalog.mjs",
    "tests:run-check": "node tooling/scripts/check-tests-run.mjs",
    "bundle:check": "node tooling/scripts/check-bundle-budget.mjs",
    "authzed:validate": "bash apps/server/authzed/validate.sh",
    "i18n:surveys:generate": "pnpm --filter @forma/surveys i18n:generate",
    "scan-translations": "pnpm --filter @forma/i18n-utils scan-translations",
    "i18n": "pnpm i18n:surveys:generate && pnpm scan-translations"
  },
  "devDependencies": {
    "js-yaml": "catalog:",
    "rimraf": "catalog:",
    "squawk-cli": "2.65.0",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0"
  },
  "packageManager": "pnpm@11.7.0"
}
