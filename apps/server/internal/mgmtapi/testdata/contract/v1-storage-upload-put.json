{
  "case": "v1-storage-upload-put",
  "description": "POST /api/v1/management/storage with the `manage` key and the file's size, on a store configured with STORAGE_UPLOAD_METHOD=put (replayed against such a server): the answer adds a presigned PUT of the same key with its Content-Type and that exact Content-Length signed (uploadMethod \"put\"); the presigned POST stays, unchanged.",
  "request": {
    "method": "POST",
    "path": "/api/v1/management/storage",
    "query": {},
    "headers": {
      "x-api-key": "<api-key:manage>",
      "content-type": "application/json"
    },
    "body": {
      "workspaceId": "<id:workspace>",
      "fileName": "logo.png",
      "fileType": "image/png",
      "fileSize": 20480
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "cache-control": "private, no-store",
      "content-security-policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' blob: data: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https://app.cal.com https:; media-src 'self' https:; object-src 'self' data: https:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
      "content-type": "application/json",
      "vary": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
      "x-frame-options": "SAMEORIGIN"
    },
    "bodyFormat": "json",
    "body": {
      "data": {
        "signedUrl": "<s3-endpoint>/forma-uploads",
        "presignedFields": {
          "Content-Type": "image/png",
          "success_action_status": "201",
          "bucket": "forma-uploads",
          "X-Amz-Algorithm": "AWS4-HMAC-SHA256",
          "X-Amz-Credential": "contractfixtureaccess/<yyyymmdd>/us-east-1/s3/aws4_request",
          "X-Amz-Date": "<s3:amz-date>",
          "key": "<id:workspace>/public/logo--fid--<uuid>.png",
          "Policy": "<s3:policy>",
          "X-Amz-Signature": "<s3:signature>"
        },
        "fileUrl": "/storage/<id:workspace>/public/logo--fid--<uuid>.png",
        "uploadMethod": "put",
        "uploadUrl": "<s3-endpoint>/forma-uploads/<id:workspace>/public/logo--fid--<uuid>.png?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Credential=contractfixtureaccess%2F<yyyymmdd>%2Fus-east-1%2Fs3%2Faws4_request&X-Amz-Date=<s3:amz-date>&X-Amz-Expires=120&X-Amz-SignedHeaders=content-length%3Bcontent-type%3Bhost&X-Amz-Signature=<s3:signature>",
        "uploadHeaders": {
          "Content-Type": "image/png"
        }
      }
    }
  },
  "notes": {
    "decodedPolicy": {
      "expiration": "<timestamp>",
      "conditions": [
        [
          "content-length-range",
          0,
          5242880
        ],
        {
          "Content-Type": "image/png"
        },
        {
          "success_action_status": "201"
        },
        {
          "bucket": "forma-uploads"
        },
        {
          "X-Amz-Algorithm": "AWS4-HMAC-SHA256"
        },
        {
          "X-Amz-Credential": "contractfixtureaccess/<yyyymmdd>/us-east-1/s3/aws4_request"
        },
        {
          "X-Amz-Date": "<s3:amz-date>"
        },
        {
          "key": "<id:workspace>/public/logo--fid--<uuid>.png"
        }
      ]
    },
    "signedHeaders": {
      "Content-Type": "image/png",
      "Content-Length": "20480",
      "Host": "localhost:9000"
    }
  }
}
