# Docker builds use the repository root as context (the Forma image in deploy/docker/Dockerfile and the documentation in apps/docs/deploy/Dockerfile). Keep secrets, dependencies and build output out of it.

# dependencies and build output; images install and build their own
**/node_modules
.pnpm-store/
**/dist/
**/coverage/
/bin/
apps/web/public/js

# secrets and local env files
**/.env
**/.env.*
!.env.example
*.pem

# version control and local tooling
.git
**/.DS_Store
.direnv
.vite-hooks/_
**/*vite.config.*.timestamp-*
