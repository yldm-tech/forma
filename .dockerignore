# Docker builds use the repository root as context (docs/deploy/Dockerfile today, the server image later). Keep secrets, dependencies and build output out of it.

# dependencies and build output; images install and build their own
**/node_modules
.pnpm-store/
**/dist/
**/coverage/
/bin/
web/public/js

# secrets and local env files
**/.env
**/.env.*
!.env.example
*.pem

# version control and local tooling
.git
**/.DS_Store
.direnv
.vite-hooks/_
**/*vite.config.*.timestamp-*
