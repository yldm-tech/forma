{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "type": {
            "type": "string",
            "const": "endScreen"
          },
          "headline": {
            "$ref": "#/$defs/__schema1"
          },
          "subheader": {
            "$ref": "#/$defs/__schema1"
          },
          "buttonLabel": {
            "$ref": "#/$defs/__schema1"
          },
          "buttonLink": {
            "$ref": "#/$defs/__schema4"
          },
          "imageUrl": {
            "$ref": "#/$defs/__schema5"
          },
          "videoUrl": {
            "$ref": "#/$defs/__schema5"
          },
          "hideDefaultIcon": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "type"
        ]
      },
      {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "type": {
            "type": "string",
            "const": "redirectToUrl"
          },
          "url": {
            "$ref": "#/$defs/__schema4"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type"
        ]
      }
    ]
  },
  "$defs": {
    "__schema0": {
      "type": "string",
      "format": "cuid2",
      "pattern": "^[0-9a-z]+$"
    },
    "__schema1": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema2"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema3"
      }
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "type": "string"
    }
  },
  "$id": "https://forma.ylam.ai/schemas/survey.endings.json"
}
