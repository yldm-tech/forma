{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "send-email"
    },
    "properties": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "format": "email"
        },
        "replyTo": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "attachResponseData": {
          "type": "boolean"
        },
        "includeVariables": {
          "type": "boolean"
        },
        "includeHiddenFields": {
          "type": "boolean"
        }
      },
      "required": [
        "to",
        "from",
        "replyTo",
        "subject",
        "body",
        "attachResponseData"
      ]
    }
  },
  "required": [
    "type",
    "properties"
  ],
  "$id": "https://forma.ylam.ai/schemas/survey_follow_up.action.json"
}
