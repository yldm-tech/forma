{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "codeConfig": {
      "type": "object",
      "properties": {
        "identifier": {
          "type": "string"
        }
      },
      "required": [
        "identifier"
      ]
    },
    "noCodeConfig": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "click"
            },
            "urlFilters": {
              "$ref": "#/$defs/__schema0"
            },
            "urlFiltersConnector": {
              "$ref": "#/$defs/__schema3"
            },
            "elementSelector": {
              "type": "object",
              "properties": {
                "cssSelector": {
                  "$ref": "#/$defs/__schema4"
                },
                "innerHtml": {
                  "$ref": "#/$defs/__schema5"
                }
              }
            }
          },
          "required": [
            "type",
            "urlFilters",
            "elementSelector"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pageView"
            },
            "urlFilters": {
              "$ref": "#/$defs/__schema0"
            },
            "urlFiltersConnector": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "urlFilters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "exitIntent"
            },
            "urlFilters": {
              "$ref": "#/$defs/__schema0"
            },
            "urlFiltersConnector": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "urlFilters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "fiftyPercentScroll"
            },
            "urlFilters": {
              "$ref": "#/$defs/__schema0"
            },
            "urlFiltersConnector": {
              "$ref": "#/$defs/__schema3"
            }
          },
          "required": [
            "type",
            "urlFilters"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "pageDwell"
            },
            "urlFilters": {
              "$ref": "#/$defs/__schema0"
            },
            "urlFiltersConnector": {
              "$ref": "#/$defs/__schema3"
            },
            "timeInSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "type",
            "urlFilters",
            "timeInSeconds"
          ]
        }
      ]
    }
  },
  "$defs": {
    "__schema0": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "$ref": "#/$defs/__schema1"
          },
          "rule": {
            "$ref": "#/$defs/__schema2"
          }
        },
        "required": [
          "value",
          "rule"
        ]
      }
    },
    "__schema1": {
      "type": "string",
      "minLength": 1
    },
    "__schema2": {
      "type": "string",
      "enum": [
        "exactMatch",
        "contains",
        "startsWith",
        "endsWith",
        "notMatch",
        "notContains",
        "matchesRegex"
      ]
    },
    "__schema3": {
      "type": "string",
      "enum": [
        "or",
        "and"
      ]
    },
    "__schema4": {
      "type": "string"
    },
    "__schema5": {
      "type": "string"
    }
  },
  "$id": "https://forma.ylam.ai/schemas/survey.inline_triggers.json"
}
