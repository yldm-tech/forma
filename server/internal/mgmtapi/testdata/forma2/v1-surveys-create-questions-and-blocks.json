{
  "case": "v1-surveys-create-questions-and-blocks",
  "description": "POST /api/v1/management/surveys with the `manage` key (manage on the workspace, organization access read and write).",
  "request": {
    "method": "POST",
    "path": "/api/v1/management/surveys",
    "query": {},
    "headers": {
      "x-api-key": "<api-key:manage>",
      "content-type": "application/json"
    },
    "body": {
      "workspaceId": "<id:workspace>",
      "name": "Link Feedback Survey",
      "type": "link",
      "status": "inProgress",
      "questions": [
        {
          "id": "feedback",
          "type": "openText",
          "headline": {
            "default": "What should we improve?"
          },
          "required": true,
          "inputType": "text",
          "charLimit": {
            "enabled": false
          }
        },
        {
          "id": "score",
          "type": "rating",
          "headline": {
            "default": "How likely are you to recommend us?"
          },
          "required": false,
          "scale": "number",
          "range": 5,
          "isColorCodingEnabled": false
        }
      ],
      "endings": [
        {
          "id": "clendscreenokaaaaaaaaaaa1",
          "type": "endScreen",
          "headline": {
            "default": "Thank you!"
          }
        }
      ],
      "hiddenFields": {
        "enabled": true,
        "fieldIds": [
          "utm_source"
        ]
      },
      "blocks": [
        {
          "id": "clblockappaaaaaaaaaaaaaa1",
          "name": "Main",
          "elements": [
            {
              "id": "checkout_feedback",
              "type": "openText",
              "headline": {
                "default": "How was checkout?"
              },
              "required": false,
              "inputType": "text",
              "charLimit": {
                "enabled": false
              }
            }
          ]
        }
      ]
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "access-control-allow-headers": "Content-Type, Authorization",
      "access-control-allow-methods": "GET, POST, PUT, DELETE, OPTIONS",
      "access-control-allow-origin": "*",
      "cache-control": "private, no-store",
      "content-security-policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' blob: data: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https://app.cal.com https:; media-src 'self' https:; object-src 'self' data: https:; base-uri 'self'; form-action 'self'; frame-ancestors 'self'",
      "content-type": "application/json",
      "vary": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
      "x-frame-options": "SAMEORIGIN"
    },
    "bodyFormat": "json",
    "body": {
      "code": "bad_request",
      "message": "Fields are missing or incorrectly formatted",
      "details": {
        "blocks": "Survey cannot have both questions and blocks. Use one model.",
        "questions": "Cannot provide both questions and blocks. Please provide only one of these fields."
      }
    }
  }
}
